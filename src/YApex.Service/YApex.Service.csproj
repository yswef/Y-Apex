<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <RootNamespace>YApex.Service</RootNamespace>
    <AssemblyName>YApex.Service</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../YApex.Core/YApex.Core.csproj" />
    <ProjectReference Include="../YApex.Wfp/YApex.Wfp.csproj" />
    <Content Include="../../config/features.json" Link="config/features.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
