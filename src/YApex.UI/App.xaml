<Application x:Class="YApex.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#F3F6FA" />
        <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#17212F" />
        <SolidColorBrush x:Key="TextSecondary" Color="#536174" />
        <SolidColorBrush x:Key="BorderColor" Color="#DEE5EF" />
        <SolidColorBrush x:Key="AccentColor" Color="#3478D4" />
        <SolidColorBrush x:Key="DangerColor" Color="#C83B42" />
        <FlowDirection x:Key="TextFlowDirection">LeftToRight</FlowDirection>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FlowDirection" Value="{DynamicResource TextFlowDirection}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource AppSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FlowDirection" Value="{DynamicResource TextFlowDirection}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource AppSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
